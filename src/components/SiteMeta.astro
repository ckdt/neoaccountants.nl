---
// <head>: titel, beschrijving, canonical, hreflang, Open Graph, JSON-LD. Zie ~/Code/_standards/SEO.md.
import { settings } from "../data/settings";
import { homePath, languages, locales, type Lang } from "../i18n/ui";
import { clampDescription, entityJsonLd, websiteJsonLd } from "../lib/seo";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  noindex?: boolean;
  /** Pad per taal voor hreflang; weglaten = geen alternates (bv. 404). */
  alternates?: Partial<Record<Lang, string>>;
}

const { lang, title, noindex = settings.noindex, alternates } = Astro.props;
const site = Astro.site!;
const description = clampDescription(Astro.props.description);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og-default.jpg", site).href;
const structuredData = [entityJsonLd(site, description), websiteJsonLd(site)];
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
{
  alternates &&
    (Object.keys(languages) as Lang[]).map(
      (l) => alternates[l] && <link rel="alternate" hreflang={l} href={new URL(alternates[l]!, site).href} />,
    )
}
{alternates && <link rel="alternate" hreflang="x-default" href={new URL(homePath.nl, site).href} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={settings.siteName} />
<meta property="og:locale" content={locales[lang]} />
{(Object.keys(locales) as Lang[]).filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={locales[l]} />)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Neo" />
<meta name="twitter:card" content="summary_large_image" />

<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

{structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
