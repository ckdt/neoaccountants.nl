---
/*
  Neo-woordmerk als inline SVG. Twee lagen: het verloop (op papier-secties) en een
  effen versie in de tekstkleur van de sectie (op gekleurde secties). Welke zichtbaar is,
  regelt de CSS via html[data-surface-top] (gezet door sections.ts).
*/
interface Props { label: string; href: string }
const { label, href } = Astro.props;
const d =
  "M26.474 0c9.219 0 15.863 6.739 15.863 18.731V43.11H28.95V19.622c0-4.756-2.28-7.432-7.038-7.432-5.355 0-8.527 2.973-8.527 8.325v22.594H0V.893h13.386l-.298 6.936C15.666 2.775 20.624 0 26.474 0zm41.935 0c15.17 0 23.4 11.298 22.408 26.065H58.792c1.288 4.358 4.858 6.837 10.907 6.837 4.858 0 8.526-1.882 10.607-3.369l7.637 8.224C83.876 41.325 78.72 44 69.896 44c-15.07 0-24.786-9.118-24.786-22.098C45.11 9.118 55.32 0 68.41 0zm.098 10.902c-5.253 0-8.824 2.379-9.913 7.432h18.74c-.598-4.657-3.57-7.432-8.827-7.432zM115.798 0C128.886 0 139 9.217 139 22.1c0 12.782-10.114 21.9-23.202 21.9-13.088 0-23.3-9.118-23.3-21.9 0-12.883 10.212-22.1 23.3-22.1zm-9.616 22.1c0 6.243 3.668 10.604 9.616 10.604 5.949 0 9.518-4.361 9.518-10.604 0-6.343-3.57-10.605-9.518-10.605s-9.616 4.262-9.616 10.605z";
---

<a class="logo" href={href} aria-label={label}>
  <svg viewBox="0 0 139 44" width="139" height="44" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="neo-gradient" x1="0" y1="0" x2="1" y2="0.35">
        <stop offset="0" stop-color="var(--brand-1)" />
        <stop offset="0.55" stop-color="var(--brand-2)" />
        <stop offset="1" stop-color="var(--brand-3)" />
      </linearGradient>
    </defs>
    <path class="logo__gradient" d={d} fill="url(#neo-gradient)" fill-rule="evenodd" />
    <path class="logo__solid" d={d} fill="currentColor" fill-rule="evenodd" />
  </svg>
</a>

<style>
  .logo {
    position: fixed;
    z-index: 20;
    inset-block-start: var(--space-s);
    inset-inline-start: var(--gutter);
    display: block;
    color: var(--ink-top);
    border-radius: var(--radius);
  }
  svg { inline-size: clamp(5.5rem, 4.5rem + 3vw, 8.7rem); block-size: auto; }
  path { transition: opacity 0.3s ease; }
  .logo__solid { opacity: 0; }
  :global(:root:not([data-surface-top="paper"])) .logo__solid { opacity: 1; }
  :global(:root:not([data-surface-top="paper"])) .logo__gradient { opacity: 0; }

  @media (min-width: 62em) {
    .logo { inset-block-start: var(--space-l); inset-inline-start: 4vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    path { transition: none; }
  }
</style>
